{
  "name": "intake-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a plain-language intake interview into a build-ready spec pack, with guardrails derived from what the user said.",
  "type": "module",
  "license": "MIT",
  "author": "Tom Pinder",
  "repository": {
    "type": "git",
    "url": "https://github.com/tjpinder/intake-kit"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --silent",
    "test": "node --test \"tests/**/*.test.ts\"",
    "golden:update": "node scripts/update-golden.mjs",
    "validate:plugin": "claude plugin validate ."
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
