{
  "name": "intake-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a plain-language intake interview into a build-ready spec pack, with guardrails derived from what the user said.",
  "type": "module",
  "license": "MIT",
  "author": "Tom Pinder",
  "repository": {
    "type": "git",
    "url": "https://github.com/tjpinder/intake-kit"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --silent",
    "test": "node --test \"tests/**/*.test.ts\"",
    "build:api": "node scripts/build-api.mjs",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck:web": "tsc --noEmit -p web",
    "golden:update": "node scripts/update-golden.mjs",
    "validate:plugin": "claude plugin validate ."
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@azure/data-tables": "13.3.2",
    "@azure/functions": "4.16.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "yaml": "2.9.1"
  }
}
